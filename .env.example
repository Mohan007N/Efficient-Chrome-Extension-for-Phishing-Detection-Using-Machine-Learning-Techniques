# Backend Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
STRICT_CORS=1
RATE_LIMIT_PER_MIN=180

# Optional API Key authentication for protected endpoints (blank disables enforcement for local dev)
WEBSHIELD_API_KEY=

# Optional Redis URL for multi-worker sliding-window rate limiting
REDIS_URL=

# Optional Explainable AI LLM Synthesis (Groq)
GROQ_API_KEY=

# Optional Threat Intelligence API Keys (gracefully skipped when blank)
URLHAUS_AUTH_KEY=
PHISHTANK_API_KEY=
